#sleela 2.9
material;
class ImagingPolicyTests {
 boolean classifier() {
  MediaClassifier c=new MediaClassifier();
  return c.isImage(".jpg") && c.isImage(".heic") && c.isImage(".png") &&
   c.isVideo(".mov") && c.isVideo(".mp4") && !c.isVideo(".jpg") && !c.isImage(".exe");
 }
 boolean dates() {
  MediaDateResolver d=new MediaDateResolver();
  return d.resolve(1000,2000)==1000 && d.resolve(0,2000)==2000 && d.resolve(0,0)==0 &&
   d.source(1000,2000)=="embedded-metadata" &&
   d.source(0,2000)=="filesystem-modified-time" && d.source(0,0)=="unknown";
 }
 boolean safety() {
  ImagingSafetyPolicy p=new ImagingSafetyPolicy();
  boolean roots=p.validRoots("/photos","/out/images","/out/mov","/out/mp4","/out/mpeg","/out/avi");
  boolean overlap=p.validRoots("/photos","/photos","/out/mov","/out/mp4","/out/mpeg","/out/avi");
  boolean duplicate=p.validRoots("/photos","/out/images","/out/mov","/out/mov","/out/mpeg","/out/avi");
  return roots && !overlap && !duplicate &&
   !p.mayApply(false,false,true,true,true,true,true,true) &&
   !p.mayApply(true,true,true,true,true,true,true,true) &&
   !p.mayApply(true,false,false,true,true,true,true,true) &&
   !p.mayApply(true,false,true,false,true,true,true,true) &&
   !p.mayApply(true,false,true,true,false,true,true,true) &&
   !p.mayApply(true,false,true,true,true,false,true,true) &&
   !p.mayApply(true,false,true,true,true,true,false,true) &&
   !p.mayApply(true,false,true,true,true,true,true,false) &&
   p.mayApply(true,false,true,true,true,true,true,true) &&
   !p.mayPublish(false,true,true,true) && !p.mayPublish(true,false,true,true) &&
   p.mayPublish(true,true,true,true) && !p.mayDeleteSource(true) &&
   !p.mayUseNetwork() && !p.mayUploadMedia() &&
   !p.mayTransmitMediaMetadata() && !p.mayFollowSymbolicLink(true);
 }
 boolean defaults() {
  ImagingConfig c=new ImagingConfig();
  return c.dryRun && c.preserveSource && c.verifyDigest &&
   !c.followSymbolicLinks && !c.allowNetwork && !c.deleteSource && c.isSafeDefault();
 }
 boolean filesystemFailsClosed() {
  ImagingFileSystem fs=new ImagingFileSystem();
  return !fs.isBound() && !fs.rootsDisjoint("/a","/b","/c","/d","/e","/f") &&
   !fs.createPreviewSnapshot("/a",false) && !fs.supportsAtomicNoReplace() &&
   !fs.supportsSha256() && !fs.supportsStableSnapshot() &&
   !fs.executeVerifiedPlan() && !fs.isRegularFile("/fixture");
 }
 boolean sessionFailsClosed() {
  ImagingConfig c=new ImagingConfig();
  c.sourceDirectory="/photos"; c.imageDestination="/out/images";
  c.movDestination="/out/mov"; c.mp4Destination="/out/mp4";
  c.mpegDestination="/out/mpeg"; c.aviDestination="/out/avi";
  ImagingSession s=new ImagingSession(); s.configure(c); s.preview();
  return s.stateName()=="blocked" && !s.canApply(true);
 }
 boolean runAll() {
  return classifier() && dates() && safety() && defaults() &&
   filesystemFailsClosed() && sessionFailsClosed();
 }
}