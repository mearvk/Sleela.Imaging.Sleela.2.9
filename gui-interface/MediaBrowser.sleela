<< MediaBrowser — native SleelaUI media browser for SLeeLa Imaging 2.9.

   A standalone desktop GUI that browses pictures and plays videos. It is a
   general media application shell with a File menu, a picture gallery that can
   load the real image files of an on-disk folder, a video canvas with full,
   live transport controls (play / pause / stop, a seek slider that drives the
   position readout, and a volume slider with a live readout), and a codec-aware
   registry so the UI only offers media it can actually play.

   Real-folder browsing is provided by the sibling GalleryScanner class, which
   enumerates a directory read-only through the VM osRun built-in using the same
   fixed-POSIX, scalar-field technique as the project's ImagingFileSystem
   provider. Type a folder path in the location bar and choose File - Open
   Folder; with no folder loaded the gallery pages a small built-in demo set.

   Look and feel deliberately match the SleelaUI house style used by the
   project's other windows and by the reference gui-dual-media-studio demo:
   a glass theme, a functional menubar strip with dropdown panels built from
   plain boxes/buttons, a header bar with navigation, a scrolled content area,
   cards, badges, a level bar, and a status bar.

   Tightening pass: transport state is centralized in one syncTransport() so the
   caption, level bar, enabled controls, and status line never drift apart; the
   seek and volume sliders are read live each frame; controls that do not apply
   in the current state are disabled; and if the player codec is unavailable the
   whole transport is gated off rather than merely labelled.

   YouTube support: the location bar doubles as a stream URL field. When it
   holds a recognizable YouTube link, the browser extracts the 11-character
   video id (via a small fixed shell command through the VM osRun built-in, the
   same scalar-field technique the gallery scanner uses), shows the recognized
   video in the player card, and offers "Open in browser" -- a platform-aware
   handoff (xdg-open / open / cmd start) that plays the video in the user's real
   browser. The browser does NOT decode or embed YouTube video itself: SleelaUI
   has no video surface or network codec, so in-app transport is honestly gated
   off for a stream and playback is delegated to the system browser rather than
   faked in the canvas. No media bytes are fetched by this program.

   This program drives the native toolkit directly through the documented ui*
   SLVM bridge; it owns no filesystem-mutating capability. It requires a native
   display (uiAppCreate); with no display it reports that and exits cleanly.

   Run on the SLeeLa VM (source-built compiler, syntax 2.9):
     SLEELA_HOME=/path/to/SLeeLa sleela run gui-interface/MediaBrowser.sleela >>
#sleela 2.9
material;
class MediaBrowser {
  << Theme preset ordinal (mirror SLUIThemeId in the toolkit C ABI). >>
  int THEME_CUSTOM = 2;
  << Scroll-policy ordinal (0 = auto scrollbars on overflow). >>
  int SCROLL_AUTO = 0;
  << Video clip length in whole seconds, used to format the position readout. >>
  int clipSeconds = 180;

  << Live widget handles the event loop reacts to. >>
  int app = -1; int theme = -1; int window = -1;
  int statusLabel = -1; int locationInput = -1;
  int videoCaption = -1; int positionLabel = -1; int volumeLabel = -1;
  int seekSlider = -1; int volumeSlider = -1; int playbackLevel = -1;
  int btnPlay = -1; int btnPause = -1; int btnStop = -1;
  int btnPrev = -1; int btnNext = -1; int galleryCaption = -1;
  << Gallery image widget: its source is updated to the current file path so the
     SleelaUI Image widget decodes and shows the real picture (jpg/jpeg/png). >>
  int thumb = -1;

  << Menubar strip and its dropdown menus. Each top-level menu (File, View,
     Stream, Help) owns a FLOATING popup panel (uiPopupCreate) that is anchored
     under its own button, sized to a fixed reasonable width, and painted as a
     raised 3D card with a drop shadow by the toolkit. Only one is open at a
     time. Every menu's items are specific to that menu (no shared children).
     All handles are packed into one int[] so the class stays under the VM's
     64-field-per-layout cap; named accessors (methods, no layout cost) read
     each slot. Index legend:
       -- top-level buttons --
       0 File btn     1 View btn     2 Stream btn    3 Help btn
       -- File menu (panel 10) --
       10 panel  11 Open Picture  12 Open Folder  13 Media Information  14 Quit
       -- View menu (panel 20) --
       20 panel  21 Picture Gallery  22 Video Player  23 Next Picture
       24 Previous Picture          25 Fit to Window
       -- Stream menu (panel 30) --
       30 panel  31 Load URL  32 Open in Browser  33 Clear Stream
       -- Help menu (panel 40) --
       40 panel  41 Media Guide  42 Keyboard Shortcuts  43 About MediaBrowser >>
  int openMenuIndex = -1;
  int[] menuH;

  << Fixed dropdown width (px): a reasonable rectangle, never the whole GUI. >>
  int MENU_WIDTH = 230;

  << Typed accessors for the packed menu handles (methods cost no layout slot). >>
  int mFileBtn() { return menuH[0]; }
  int mViewBtn() { return menuH[1]; }
  int mStreamBtn() { return menuH[2]; }
  int mHelpBtn() { return menuH[3]; }

  int mFilePanel() { return menuH[10]; }
  int mFileOpen() { return menuH[11]; }
  int mFileOpenFolder() { return menuH[12]; }
  int mFileInfo() { return menuH[13]; }
  int mFileQuit() { return menuH[14]; }

  int mViewPanel() { return menuH[20]; }
  int mViewGallery() { return menuH[21]; }
  int mViewPlayer() { return menuH[22]; }
  int mViewNext() { return menuH[23]; }
  int mViewPrev() { return menuH[24]; }
  int mViewFit() { return menuH[25]; }

  int mStreamPanel() { return menuH[30]; }
  int mStreamLoad() { return menuH[31]; }
  int mStreamOpen() { return menuH[32]; }
  int mStreamClear() { return menuH[33]; }

  int mHelpPanel() { return menuH[40]; }
  int mHelpGuide() { return menuH[41]; }
  int mHelpShortcuts() { return menuH[42]; }
  int mHelpAbout() { return menuH[43]; }

  << Picture gallery state. When no on-disk folder is loaded the browser pages
     through a small fixed demo set; a real-folder scan (inlined below, the same
     logic as the sibling GalleryScanner modular class) replaces it with the
     actual image files of a chosen folder. >>
  int galleryIndex = 0;
  int demoCount = 5;
  int galleryCount = 5;
  boolean folderLoaded = false;
  String folderPath = "";
  << Per-run work area for the read-only folder scan. >>
  String scanDir = "";
  int scanCount = 0;

  << Player transport state kept in SLeeLa; the toolkit renders it. The codec
     gate decides, once, whether the player may run at all. >>
  boolean playable = false;
  boolean playing = false;
  boolean running = false;
  << Last seek position read from the slider, in whole seconds. >>
  int lastPos = 0;

  << YouTube stream state. streamActive is true while the location bar holds a
     recognized YouTube URL; streamId is the extracted 11-char video id and
     streamUrl the canonical watch URL. A stream cannot be decoded in-app, so
     the in-app transport is gated off and playback is handed to the browser. >>
  boolean streamActive = false;
  String streamId = "";
  String streamUrl = "";
  String streamParseDir = "";
  << UI handles for the stream row (Open in browser). The stream menu handles
     (button, panel, Load/Open/Clear) live in the packed menuH array above. >>
  int btnStreamOpen = -1; int streamCaption = -1;

  << ---- Descriptive metadata (version 1.11 nested-friendly accessors) ---- >>
  String metaVersion = "1.3.0";
  int metaId = 2911;
  String metaAuthor = "Max Rupplin / MEARVK LLC";
  String metaDate = "2026-11-01";
  String metaCopyright = "MEARVK LLC";
  String metaTrademark = "none";
  String metaCorporation = "MEARVK LLC";
  String metaOrigin = "International";
  String metaBirthDate = "2026-11-01";
  int metaScienceRating = 6;
  String metaNationalSchedule = "none";
  String getMetaVersion() { return metaVersion; }
  int getMetaId() { return metaId; }
  String getAuthor() { return metaAuthor; }
  String getOrigin() { return metaOrigin; }
  String getNationalSchedule() { return metaNationalSchedule; }

  int rgba(int r, int g, int b, int a) { return r * 16777216 + g * 65536 + b * 256 + a; }
  int rgb(int r, int g, int b) { return rgba(r, g, b, 255); }
  String intToStr(int v) { return "" + v; }
  int clampInt(int v, int lo, int hi) { if (v < lo) return lo; if (v > hi) return hi; return v; }

  << Codec gate: the browser consults this before offering a playback control.
     The UI never offers media it cannot play. >>
  boolean canPlayType(String mime) {
    return mime == "image/jpeg" || mime == "image/png" || mime == "image/gif" ||
      mime == "video/mp4" || mime == "video/quicktime" || mime == "audio/wav" ||
      mime == "video/x-msvideo";
  }

  << AVI is a recognized video container but SleelaUI has no in-app video
     decoder or surface, so (like YouTube streams) AVI is played by handing the
     file to the system's external player rather than decoding it in-app. This
     reports whether a type is a recognized external-playback video. >>
  boolean isExternalVideo(String mime) {
    return mime == "video/x-msvideo";
  }

  << Map a lowercase file extension to a MIME type for the codec gate. Unknown
     extensions return "" (treated as not playable). >>
  String mimeForExt(String ext) {
    if (ext == "jpg" || ext == "jpeg") return "image/jpeg";
    if (ext == "png") return "image/png";
    if (ext == "gif") return "image/gif";
    if (ext == "mp4" || ext == "m4v") return "video/mp4";
    if (ext == "mov") return "video/quicktime";
    if (ext == "avi") return "video/x-msvideo";
    if (ext == "wav") return "audio/wav";
    return "";
  }

  << ---- Inlined read-only folder scanner (mirrors gui-interface/GalleryScanner.sleela).
     Enumerates image files in one directory via the VM osRun built-in using the
     fixed-POSIX, scalar-field technique of the project's ImagingFileSystem
     provider: results are written WITHOUT a trailing newline to per-record field
     files and read back by index. The scan never creates, moves, or deletes
     media, and never follows symbolic links (find -P ... ! -type l). ---- >>

  << Quote a path for a double-quoted argument inside the single-quoted sh
     command. The folder is validated (osIsDir) before any command runs. >>
  String q(String path) { return "\"" + path + "\""; }

  << Read one scalar field file produced by the shell (no trailing newline). >>
  String readField(String path) {
    int h = openFile(path, "r");
    if (h < 0) return "";
    String s = read(h);
    close(h);
    return s;
  }

  << Scan one directory (non-recursive) for allow-listed image files. On success
     sets scanDir + scanCount and returns the count; returns 0 on any failure or
     empty folder. >>
  int scanFolder(String folder) {
    scanCount = 0;
    if (folder == "") return 0;
    if (osIsDir(folder) != 1) return 0;
    String base = osTempDir() + "/sleela-gallery";
    osMakeDir(base);
    if (osIsDir(base) != 1) { base = ".sleela-gallery-work"; osMakeDir(base); }
    scanDir = base + "/run-" + timeUtcMillis();
    osMakeDir(scanDir);
    if (osIsDir(scanDir) != 1) return 0;
    String list = scanDir + "/list.txt";
    << Enumerate basenames of image files, symlinks excluded, sorted for a
       stable order. Any error collapses to a stable empty list. >>
    osRun("sh -c 'cd " + q(folder) + " 2>/dev/null && ls -1 2>/dev/null "
      + "| grep -iE \"[.](jpg|jpeg|png|gif|bmp|webp|tiff|tif)$\" "
      + "| sort > " + q(list) + " || : > " + q(list) + "'");
    << For each basename emit k.name (basename) and k.path (absolute path). >>
    String wd = scanDir;
    osRun("sh -c '"
      + "k=0; f=" + q(folder) + "; "
      + "while IFS= read -r b; do "
      + "printf \"%s\" \"$b\" > \"" + wd + "/$k.name\"; "
      + "printf \"%s/%s\" \"$f\" \"$b\" > \"" + wd + "/$k.path\"; "
      + "k=$((k+1)); done < " + q(list) + "; "
      + "printf \"%s\" \"$k\" > \"" + wd + "/count.txt\""
      + "'");
    int k = 0;
    while (k < 100000 && osExists(scanDir + "/" + k + ".name") == 1) { k = k + 1; }
    scanCount = k;
    return scanCount;
  }

  String scanNameAt(int i) {
    if (i < 0 || i >= scanCount) return "";
    return readField(scanDir + "/" + i + ".name");
  }
  String scanPathAt(int i) {
    if (i < 0 || i >= scanCount) return "";
    return readField(scanDir + "/" + i + ".path");
  }

  << ---- YouTube URL support ----
     SLeeLa primitive String has no indexOf/substring, so the 11-character
     YouTube video id is extracted from the (opaque) URL by a small fixed shell
     command through osRun, written WITHOUT a trailing newline to a per-run
     field file and read back -- the same scalar-field technique the folder
     scanner uses. The command is quoted and the URL is passed as a positional
     argument so its contents can never change the command structure. No network
     is touched: this only pattern-matches the id out of the URL text.
     (Reuses the q() and readField() helpers defined for the folder scanner.) ---- >>

  << Extract the 11-char video id from a YouTube URL, or "" when not YouTube.
     Recognizes watch?v=, youtu.be/, /embed/, and /shorts/ shapes. >>
  String youtubeId(String url) {
    if (url == "") return "";
    String base = osTempDir() + "/sleela-mb-yt";
    osMakeDir(base);
    if (osIsDir(base) != 1) { base = ".sleela-mb-yt"; osMakeDir(base); }
    streamParseDir = base + "/run-" + timeUtcMillis();
    osMakeDir(streamParseDir);
    if (osIsDir(streamParseDir) != 1) return "";
    String f = streamParseDir + "/id.txt";
    << $1 is the URL (positional, never interpolated into the program text). The
       grep pulls an id that follows one of the known YouTube markers, then the
       second grep keeps only the 11-char id token. Empty file on no match. >>
    osRun("sh -c 'printf %s \"$1\" "
      + "| grep -oE \"([?&]v=|youtu[.]be/|/embed/|/shorts/)[A-Za-z0-9_-]{11}\" "
      + "| grep -oE \"[A-Za-z0-9_-]{11}$\" "
      + "| head -1 | tr -d \"\\n\" > " + q(f) + " || : > " + q(f) + "' sh " + q(url));
    return readField(f);
  }

  << ---- Native file-open dialog ----
     SleelaUI ships no file-chooser widget, so the File menu opens the real
     native desktop picker by launching zenity (GNOME/GTK) or kdialog (KDE)
     through the VM osRun built-in, and reads the chosen path back from a scalar
     field file (no trailing newline) -- the same fixed-POSIX, scalar-field
     technique the folder scanner uses. Returns the selected absolute path, or
     "" if the user cancelled or no picker is installed. Read-only: it only
     learns a path; it never creates, moves, or deletes media. >>
  String openFileDialog(String title) {
    String base = osTempDir() + "/sleela-mb-pick";
    osMakeDir(base);
    if (osIsDir(base) != 1) { base = ".sleela-mb-pick"; osMakeDir(base); }
    String dir = base + "/run-" + timeUtcMillis();
    osMakeDir(dir);
    if (osIsDir(dir) != 1) return "";
    String f = dir + "/path.txt";
    << $1 is the dialog title, passed positionally so it can never alter the
       command structure. Try zenity first, then kdialog; the chosen path is
       written with no trailing newline, empty on cancel or no picker. >>
    osRun("sh -c '"
      + "if command -v zenity >/dev/null 2>&1; then "
      + "  zenity --file-selection --title=\"$1\" 2>/dev/null; "
      + "elif command -v kdialog >/dev/null 2>&1; then "
      + "  kdialog --getopenfilename \"$HOME\" --title \"$1\" 2>/dev/null; "
      + "fi | head -1 | tr -d \"\\n\" > " + q(f) + " || : > " + q(f) + "' sh " + q(title));
    return readField(f);
  }

  << Lowercase file extension of a path (via the char-cell-free shell helper),
     used to pick the MIME type for an opened file. Empty when there is no dot.
     Reuses the scalar-field technique. >>
  String extOf(String path) {
    if (path == "") return "";
    String base = osTempDir() + "/sleela-mb-ext";
    osMakeDir(base);
    if (osIsDir(base) != 1) { base = ".sleela-mb-ext"; osMakeDir(base); }
    String dir = base + "/run-" + timeUtcMillis();
    osMakeDir(dir);
    if (osIsDir(dir) != 1) return "";
    String f = dir + "/ext.txt";
    << Take the text after the last dot of the basename, lowercased; empty when
       the basename has no dot. $1 is the path (positional). >>
    osRun("sh -c '"
      + "p=\"$1\"; b=\"${p##*/}\"; "
      + "case \"$b\" in *.*) e=\"${b##*.}\";; *) e=\"\";; esac; "
      + "printf \"%s\" \"$e\" | tr \"A-Z\" \"a-z\" > " + q(f) + " || : > " + q(f) + "' sh " + q(path));
    return readField(f);
  }

  boolean looksYouTube(String url) { return youtubeId(url) != ""; }

  << Platform-aware external open of a URL in the user's browser. Returns true
     when the launcher reported success (exit 0). Honestly reports failure (for
     example on a headless host with no opener) rather than pretending. >>
  boolean openExternally(String url) {
    if (url == "") return false;
    String plat = osPlatform();
    int rc = -1;
    if (plat == "macOS") {
      rc = osRun("sh -c 'open \"$1\"' sh " + q(url));
    } else if (plat == "Windows") {
      rc = osRun("cmd /c start \"\" " + q(url));
    } else {
      << Linux and others: try xdg-open, then a couple of common fallbacks. >>
      rc = osRun("sh -c 'xdg-open \"$1\" 2>/dev/null || gio open \"$1\" 2>/dev/null || sensible-browser \"$1\" 2>/dev/null' sh " + q(url));
    }
    return rc == 0;
  }

  << Name of the current gallery entry: a real file when a folder is loaded,
     otherwise one of the built-in demo names. >>
  String demoName(int i) {
    if (i == 0) return "beach-sunrise.jpg";
    if (i == 1) return "mountain-trail.png";
    if (i == 2) return "city-lights.jpg";
    if (i == 3) return "forest-path.gif";
    return "harbor-dusk.jpg";
  }
  String pictureName(int i) {
    if (folderLoaded) {
      String nm = scanNameAt(i);
      if (nm != "") return nm;
    }
    return demoName(i);
  }
  << Absolute (or demo) path shown in the location bar for the current entry. >>
  String picturePath(int i) {
    if (folderLoaded) {
      String p = scanPathAt(i);
      if (p != "") return p;
    }
    return "file:///pictures/" + demoName(i);
  }

  << Load a real on-disk folder into the gallery. Reads the path from the
     location bar, scans it read-only, and switches the gallery over to the real
     files. Falls back to the demo set when the path is invalid or has no
     images. >>
  void loadFolder(String path) {
    if (path == "") { setStatus("Open Folder: enter a folder path in the location bar first."); return; }
    int found = scanFolder(path);
    if (found > 0) {
      folderLoaded = true;
      folderPath = path;
      galleryCount = found;
      galleryIndex = 0;
      showPicture();
      setStatus("Loaded " + intToStr(found) + " image(s) from " + path);
    } else {
      folderLoaded = false;
      galleryCount = demoCount;
      galleryIndex = 0;
      showPicture();
      setStatus("No images found in " + path + " - showing the built-in demo set.");
    }
  }

  << Parent directory of a path, via a fixed shell helper (scalar-field read).
     Used to load the folder of a file chosen in the native file dialog. >>
  String dirOf(String path) {
    if (path == "") return "";
    String base = osTempDir() + "/sleela-mb-dir";
    osMakeDir(base);
    if (osIsDir(base) != 1) { base = ".sleela-mb-dir"; osMakeDir(base); }
    String dir = base + "/run-" + timeUtcMillis();
    osMakeDir(dir);
    if (osIsDir(dir) != 1) return "";
    String f = dir + "/dir.txt";
    osRun("sh -c 'printf \"%s\" \"$(dirname \"$1\")\" > " + q(f) + " || : > " + q(f) + "' sh " + q(path));
    return readField(f);
  }

  << File menu - Open Picture: pop the native file dialog, and if an image was
     chosen, load its folder into the gallery and page straight to that file so
     the picture is shown immediately. A chosen video is handed to the external
     player (SleelaUI decodes no video). >>
  void openPicture() {
    String picked = openFileDialog("Open a picture or video");
    if (picked == "") { setStatus("Open: cancelled (or no zenity/kdialog file picker installed)."); return; }
    String ext = extOf(picked);
    String mime = mimeForExt(ext);
    if (isExternalVideo(mime) || mime == "video/mp4" || mime == "video/quicktime") {
      << A video file: play it in the system's external player. >>
      if (openExternally(picked)) setStatus("Opened " + picked + " in the system video player.");
      else setStatus("Could not launch an external player for " + picked + ".");
      return;
    }
    << An image (or unknown, which the Image widget will simply caption): load
       the containing folder so Prev/Next browse its siblings, then jump to the
       chosen file. >>
    String folder = dirOf(picked);
    int found = folder != "" ? scanFolder(folder) : 0;
    if (found > 0) {
      folderLoaded = true;
      folderPath = folder;
      galleryCount = found;
      << Page to the picked file by matching its basename. >>
      galleryIndex = 0;
      int i = 0;
      while (i < found) {
        String nm = scanPathAt(i);
        if (nm == picked) { galleryIndex = i; i = found; } else { i = i + 1; }
      }
      showPicture();
      setStatus("Opened " + picked + " (" + intToStr(found) + " image(s) in folder).");
    } else {
      << Single file with no scannable folder: show it directly in the gallery. >>
      folderLoaded = false;
      if (thumb >= 0) uiWidgetSetText(thumb, picked);
      if (locationInput >= 0) uiWidgetSetText(locationInput, picked);
      setStatus("Opened " + picked + ".");
    }
  }

  << A glass media theme shared with the project's other SleelaUI windows. >>
  int glassTheme() {
    int t = uiThemePreset(THEME_CUSTOM);
    uiThemeSetBg(t, rgb(14, 23, 38));
    uiThemeSetSurface(t, rgb(24, 36, 56));
    uiThemeSetSurfaceHi(t, rgb(36, 52, 78));
    uiThemeSetChrome(t, rgb(28, 42, 64));
    uiThemeSetBorder(t, rgba(130, 170, 230, 55));
    uiThemeSetFg(t, rgb(232, 240, 250));
    uiThemeSetFgDim(t, rgb(150, 172, 198));
    uiThemeSetAccent(t, rgb(91, 141, 239));
    uiThemeSetAccentFg(t, rgb(10, 18, 32));
    uiThemeSetDanger(t, rgb(228, 122, 122));
    uiThemeSetRadius(t, 12);
    uiThemeSetControlHeight(t, 32);
    return t;
  }

  void setStatus(String message) { if (statusLabel >= 0) uiWidgetSetText(statusLabel, message); }

  << Format a whole-second position as "position Xs / Ys". >>
  String positionText(int seconds) {
    return "position " + intToStr(seconds) + "s / " + intToStr(clipSeconds) + "s";
  }

  << Show one dropdown at a time; selecting the open menu closes it. >>
  void openMenu(int which) {
    int next = openMenuIndex == which ? -1 : which;
    openMenuIndex = next;
    uiWidgetVisible(mFilePanel(), next == 0 ? 1 : 0);
    uiWidgetVisible(mViewPanel(), next == 1 ? 1 : 0);
    uiWidgetVisible(mStreamPanel(), next == 2 ? 1 : 0);
    uiWidgetVisible(mHelpPanel(), next == 3 ? 1 : 0);
  }

  << Repaint the gallery caption and reflect the current file in the location
     bar for the current index. >>
  void showPicture() {
    String name = pictureName(galleryIndex);
    String src = folderLoaded ? "folder" : "demo";
    if (galleryCaption >= 0) {
      uiWidgetSetText(galleryCaption, "picture " + intToStr(galleryIndex + 1) + " / " +
        intToStr(galleryCount) + "   -   " + name);
    }
    << Point the gallery Image widget at the real on-disk file so SleelaUI
       decodes and renders the actual picture. For a loaded folder that is the
       absolute scan path; the built-in demo set has no real files, so the
       widget shows its caption-tile fallback (the filename). >>
    if (thumb >= 0) {
      String imgSrc = folderLoaded ? scanPathAt(galleryIndex) : name;
      uiWidgetSetText(thumb, imgSrc);
    }
    if (locationInput >= 0) uiWidgetSetText(locationInput, picturePath(galleryIndex));
    setStatus("Browsing " + name + " (" + src + " image, codec gate passed)");
  }

  void nextPicture() {
    galleryIndex = galleryIndex + 1;
    if (galleryIndex >= galleryCount) galleryIndex = 0;
    showPicture();
  }
  void prevPicture() {
    galleryIndex = galleryIndex - 1;
    if (galleryIndex < 0) galleryIndex = galleryCount - 1;
    showPicture();
  }

  << Single source of truth for transport presentation: caption, enabled
     controls, and the playback level bar all follow from (playable, playing,
     lastPos). Called after every state change and every seek. >>
  void syncTransport() {
    << A YouTube stream cannot be decoded or embedded in-app (no video surface
       or network codec in SleelaUI), so the in-app transport is gated off and
       the caption points the user at the browser handoff. >>
    boolean localActive = playable && !streamActive;
    if (videoCaption >= 0) {
      String s;
      if (streamActive) s = "YouTube stream: open in browser to play";
      else if (!playable) s = "transport: unavailable (codec not supported)";
      else if (playing) s = "transport: playing";
      else if (lastPos > 0) s = "transport: paused";
      else s = "transport: stopped";
      uiWidgetSetText(videoCaption, s);
    }
    if (positionLabel >= 0) uiWidgetSetText(positionLabel, positionText(lastPos));
    if (playbackLevel >= 0) {
      double frac = clipSeconds > 0 ? (lastPos * 1.0) / (clipSeconds * 1.0) : 0.0;
      uiWidgetSetValue(playbackLevel, frac);
    }
    << Enable only the controls that apply in the current state. >>
    if (btnPlay >= 0) uiWidgetSensitive(btnPlay, (localActive && !playing) ? 1 : 0);
    if (btnPause >= 0) uiWidgetSensitive(btnPause, (localActive && playing) ? 1 : 0);
    if (btnStop >= 0) uiWidgetSensitive(btnStop, (localActive && (playing || lastPos > 0)) ? 1 : 0);
    if (seekSlider >= 0) uiWidgetSensitive(seekSlider, localActive ? 1 : 0);
    if (volumeSlider >= 0) uiWidgetSensitive(volumeSlider, localActive ? 1 : 0);
    << The browser-handoff action is live only while a stream is recognized. >>
    if (btnStreamOpen >= 0) uiWidgetSensitive(btnStreamOpen, streamActive ? 1 : 0);
    if (streamCaption >= 0)
      uiWidgetSetText(streamCaption, streamActive
        ? ("stream: youtube id " + streamId)
        : "stream: paste a YouTube URL in the location bar, then Stream - Load URL");
  }

  << Recognize the location bar as a YouTube URL and switch the player card to
     stream mode. Returns true when a stream was loaded. >>
  boolean loadStream(String url) {
    String id = youtubeId(url);
    if (id == "") {
      setStatus("Not a recognized YouTube URL: " + url);
      return false;
    }
    streamActive = true;
    streamId = id;
    streamUrl = "https://www.youtube.com/watch?v=" + id;
    playing = false;
    lastPos = 0;
    if (seekSlider >= 0) uiWidgetSetValue(seekSlider, 0.0);
    syncTransport();
    setStatus("YouTube video " + id + " recognized. Open in browser to play (in-app video is not decoded).");
    return true;
  }

  << Leave stream mode and return to the local demo player. >>
  void clearStream() {
    streamActive = false;
    streamId = "";
    streamUrl = "";
    syncTransport();
    setStatus("Stream cleared. Local player restored.");
  }

  << Hand the current stream to the system browser for actual playback. >>
  void openStream() {
    if (!streamActive) { setStatus("No YouTube URL loaded. Stream - Load URL first."); return; }
    if (openExternally(streamUrl)) {
      setStatus("Opened " + streamUrl + " in the system browser.");
    } else {
      setStatus("Could not launch a browser for " + streamUrl + " (no opener on this host). URL is ready to copy.");
    }
  }

  void playMedia() {
    if (!playable) { setStatus("DENIED: video/mp4 is not playable on this system."); return; }
    playing = true;
    syncTransport();
    setStatus("video/mp4 playing (codec gate passed)");
  }
  void pauseMedia() {
    if (!playable || !playing) return;
    playing = false;
    syncTransport();
    setStatus("video paused at " + intToStr(lastPos) + "s");
  }
  void stopMedia() {
    if (!playable) return;
    playing = false;
    lastPos = 0;
    if (seekSlider >= 0) uiWidgetSetValue(seekSlider, 0.0);
    syncTransport();
    setStatus("video stopped (position reset to 0s)");
  }

  << Read the live slider values each frame and reflect them. The seek slider
     drives the position readout and the level bar; the volume slider drives the
     volume readout. Only updates the status line when a value actually moves. >>
  void pollSliders() {
    if (!playable) return;
    if (seekSlider >= 0) {
      double sv = uiWidgetGetValue(seekSlider);
      int pos = clampInt((int) sv, 0, clipSeconds);
      if (pos != lastPos) {
        lastPos = pos;
        if (positionLabel >= 0) uiWidgetSetText(positionLabel, positionText(lastPos));
        if (playbackLevel >= 0) {
          double frac = clipSeconds > 0 ? (lastPos * 1.0) / (clipSeconds * 1.0) : 0.0;
          uiWidgetSetValue(playbackLevel, frac);
        }
        if (btnStop >= 0) uiWidgetSensitive(btnStop, (playing || lastPos > 0) ? 1 : 0);
        setStatus("seek " + intToStr(lastPos) + "s / " + intToStr(clipSeconds) + "s");
      }
    }
    if (volumeSlider >= 0 && volumeLabel >= 0) {
      int vol = clampInt((int) uiWidgetGetValue(volumeSlider), 0, 100);
      uiWidgetSetText(volumeLabel, "volume " + intToStr(vol) + "%");
    }
  }

  void main() {
    print("SLeeLa Imaging MediaBrowser (native SleelaUI) - backend "
      + uiBackendName(uiBackend()) + ", toolkit " + uiVersion());

    app = uiAppCreate("com.mearvk.sleela.imaging.mediabrowser");
    if (app < 0) {
      print("No display available (headless): the ui* bridge is wired, but the");
      print("toolkit could not open a window. Run on a desktop (X/Cocoa/Win32).");
      return;
    }

    theme = glassTheme();
    window = uiWindowCreate(app, "SLeeLa Media Browser - Imaging 2.9", 1100, 720, theme);
    if (window < 0) {
      print("MediaBrowser: native window creation failed.");
      uiAppDestroy(app); app = -1; return;
    }
    uiWindowSetBuffering(window, 2);
    uiWindowSetMinSize(window, 900, 600);
    int root = uiWindowRoot(window);

    << Allocate the packed menu-handle table (see the index legend by the field
       declaration). Indices are grouped by menu (0-3 buttons, 10-14 File,
       20-25 View, 30-33 Stream, 40-43 Help), so size to the highest slot + 1.
       Unused gaps stay at their default and are never referenced. >>
    menuH = new int[44];
    int mi = 0;
    while (mi < 44) { menuH[mi] = -1; mi = mi + 1; }

    << ---- Functional menubar strip ---- >>
    int menuStrip = uiBox(root, 1, 4);
    uiWidgetMargin(menuStrip, 4, 8, 4, 8);
    menuH[0] = uiButton(menuStrip, "File");
    menuH[1] = uiButton(menuStrip, "View");
    menuH[2] = uiButton(menuStrip, "Stream");
    menuH[3] = uiButton(menuStrip, "Help");
    uiSpacer(menuStrip);

    << Each dropdown is anchored to ITS OWN menu button with uiPopupAnchorTo: the
       toolkit centers the panel horizontally on the button's real laid-out rect
       (exact, not estimated) and draws a centered teardrop caret pointing up at
       the button. >>

    << ---- File menu: a floating, fixed-width, raised dropdown ---- >>
    menuH[10] = uiPopupCreate(root);
    uiWidgetSizeRequest(mFilePanel(), MENU_WIDTH, 0);
    uiPopupAnchorTo(mFilePanel(), mFileBtn());
    int fBox = uiBox(mFilePanel(), 0, 2);
    uiWidgetMargin(fBox, 6, 8, 6, 8);
    menuH[11] = uiButton(fBox, "Open Picture...");
    menuH[12] = uiButton(fBox, "Open Folder...");
    menuH[13] = uiButton(fBox, "Media Information");
    uiSeparator(fBox, 0);
    menuH[14] = uiButton(fBox, "Quit");

    << ---- View menu ---- >>
    menuH[20] = uiPopupCreate(root);
    uiWidgetSizeRequest(mViewPanel(), MENU_WIDTH, 0);
    uiPopupAnchorTo(mViewPanel(), mViewBtn());
    int vBox = uiBox(mViewPanel(), 0, 2);
    uiWidgetMargin(vBox, 6, 8, 6, 8);
    menuH[21] = uiButton(vBox, "Picture Gallery");
    menuH[22] = uiButton(vBox, "Video Player");
    uiSeparator(vBox, 0);
    menuH[23] = uiButton(vBox, "Next Picture");
    menuH[24] = uiButton(vBox, "Previous Picture");
    menuH[25] = uiButton(vBox, "Fit to Window");

    << ---- Stream menu ---- >>
    menuH[30] = uiPopupCreate(root);
    uiWidgetSizeRequest(mStreamPanel(), MENU_WIDTH, 0);
    uiPopupAnchorTo(mStreamPanel(), mStreamBtn());
    int sBox = uiBox(mStreamPanel(), 0, 2);
    uiWidgetMargin(sBox, 6, 8, 6, 8);
    menuH[31] = uiButton(sBox, "Load URL from Location Bar");
    menuH[32] = uiButton(sBox, "Open in Browser");
    menuH[33] = uiButton(sBox, "Clear Stream");

    << ---- Help menu ---- >>
    menuH[40] = uiPopupCreate(root);
    uiWidgetSizeRequest(mHelpPanel(), MENU_WIDTH, 0);
    uiPopupAnchorTo(mHelpPanel(), mHelpBtn());
    int hBox = uiBox(mHelpPanel(), 0, 2);
    uiWidgetMargin(hBox, 6, 8, 6, 8);
    menuH[41] = uiButton(hBox, "Media Guide");
    menuH[42] = uiButton(hBox, "Keyboard Shortcuts");
    menuH[43] = uiButton(hBox, "About MediaBrowser");

    << ---- Chrome: navigation header ---- >>
    int header = uiHeaderBar(root);
    btnPrev = uiButton(header, "< Prev"); uiTooltip(btnPrev, "Previous picture");
    btnNext = uiButton(header, "Next >"); uiTooltip(btnNext, "Next picture");
    locationInput = uiEntry(header, "/path/to/pictures");
    uiTooltip(locationInput, "Folder path to scan, or the current file");
    uiWidgetExpand(locationInput, 1, 0);
    uiWidgetMargin(locationInput, 0, 8, 0, 8);
    uiBadge(header, "local - no network");

    << Content scrolls inside a scrolled view instead of spilling past the frame. >>
    int scroller = uiScrolledView(root, SCROLL_AUTO, SCROLL_AUTO);
    uiWidgetExpand(scroller, 1, 1);
    int content = uiBox(scroller, 0, 14);
    uiWidgetMargin(content, 16, 16, 16, 16);
    uiWidgetExpand(content, 1, 1);

    uiHeading(content, "SLeeLa Media Browser", 24);
    uiLabel(content, "Browse pictures and play videos. Type a folder in the location bar and choose File - Open Folder to load real images. Local-first; originals are never modified.");

    << Two-column layout: picture gallery on the left, video player on the right. >>
    int cols = uiBox(content, 1, 16);
    uiWidgetExpand(cols, 1, 1);
    int colL = uiBox(cols, 0, 12);
    uiWidgetExpand(colL, 1, 1);
    int colR = uiBox(cols, 0, 12);
    uiWidgetExpand(colR, 1, 1);

    << Picture gallery card. >>
    int gallery = uiCard(colL);
    uiWidgetExpand(gallery, 1, 1);
    int gBox = uiBox(gallery, 0, 8);
    uiWidgetMargin(gBox, 12, 12, 12, 12);
    uiWidgetExpand(gBox, 1, 1);
    uiLabel(gBox, "PICTURE GALLERY  (image/jpeg - png - gif)");
    << Bound to the instance field so showPicture() can swap its source to the
       current file and the Image widget renders the real decoded picture. >>
    thumb = uiImage(gBox, "beach-sunrise.jpg", 420, 300);
    uiWidgetExpand(thumb, 1, 1);
    galleryCaption = uiLabel(gBox, "picture 1 / 5   -   beach-sunrise.jpg");
    int gRow = uiBox(gBox, 1, 8);
    int gPrev = uiButton(gRow, "< Previous");
    int gNext = uiButton(gRow, "Next >");
    uiSpacer(gRow);
    uiBadge(gRow, "fit to window");

    << Video player card with full transport (codec-gated on video/mp4). >>
    playable = canPlayType("video/mp4");
    int player = uiCard(colR);
    uiWidgetExpand(player, 1, 1);
    int pBox = uiBox(player, 0, 8);
    uiWidgetMargin(pBox, 12, 12, 12, 12);
    uiWidgetExpand(pBox, 1, 1);
    uiLabel(pBox, "VIDEO PLAYER  (video/mp4 - playable=" + (playable ? "yes" : "no") + ")");
    int canvas = uiImage(pBox, "intro.mp4", 420, 236);
    uiWidgetExpand(canvas, 1, 1);
    videoCaption = uiLabel(pBox, "transport: stopped");
    positionLabel = uiLabel(pBox, positionText(0));
    seekSlider = uiSlider(pBox, 0.0, 180.0, 0.0); uiTooltip(seekSlider, "Seek position");
    int transport = uiBox(pBox, 1, 8);
    btnPlay = uiButton(transport, "Play"); uiWidgetSuggested(btnPlay, 1); uiTooltip(btnPlay, "Play");
    btnPause = uiButton(transport, "Pause"); uiTooltip(btnPause, "Pause");
    btnStop = uiButton(transport, "Stop"); uiTooltip(btnStop, "Stop and rewind");
    uiSpacer(transport);
    volumeLabel = uiLabel(transport, "volume 80%");
    volumeSlider = uiSlider(transport, 0.0, 100.0, 80.0); uiTooltip(volumeSlider, "Volume");
    int lrow = uiBox(pBox, 1, 8);
    uiLabel(lrow, "playback");
    playbackLevel = uiLevelBar(lrow, 0.0);
    uiWidgetExpand(playbackLevel, 1, 0);

    << YouTube stream row: recognized-video caption + browser handoff. In-app
       decode is not possible, so playback is delegated to the system browser. >>
    uiSeparator(pBox, 1);
    streamCaption = uiLabel(pBox, "stream: paste a YouTube URL in the location bar, then Stream - Load URL");
    int srow = uiBox(pBox, 1, 8);
    btnStreamOpen = uiButton(srow, "Open in browser"); uiWidgetSuggested(btnStreamOpen, 1);
    uiTooltip(btnStreamOpen, "Play the recognized YouTube video in your browser");
    uiWidgetSensitive(btnStreamOpen, 0);
    uiSpacer(srow);
    uiBadge(srow, "stream = browser handoff");

    << Codec registry card (full width): what the UI will and will not offer. >>
    int codec = uiCard(content);
    uiWidgetExpand(codec, 1, 0);
    int cBox = uiBox(codec, 0, 6);
    uiWidgetMargin(cBox, 12, 12, 12, 12);
    uiLabel(cBox, "CODEC REGISTRY  (the UI only offers media it can play)");
    int crow = uiBox(cBox, 1, 8);
    uiBadge(crow, "image/jpeg ok");
    uiBadge(crow, "image/png ok");
    uiBadge(crow, "image/gif ok");
    uiBadge(crow, "video/mp4 ok");
    uiBadge(crow, "video/quicktime ok");
    uiBadge(crow, "video/avi -> external player");
    uiSpacer(crow);

    int status = uiStatusBar(root);
    statusLabel = uiLabel(status, "Ready - browse pictures with Prev/Next, play video with the transport controls.");
    uiWidgetMargin(statusLabel, 0, 12, 0, 12);

    uiWindowShow(window);
    running = true;
    showPicture();
    syncTransport();
    print("Window shown. Gallery and transport controls change the view and player state.");

    << ---- Interactive event loop: pump, poll sliders, then poll controls.
       The loop ends only on an explicit quit (File - Quit) or when the user
       closes the window (uiWindowClosed, the WM close / X button) -- NOT on a
       single negative uiAppPump result. uiAppPump dispatches events once and
       returns the dispatched-event count, or a negative error code; treating
       an occasional negative as "quit" made the window appear to exit right
       after loading if the backend returned a transient error on a frame.
       A persistent failure (window gone) is caught by the uiWindowClosed
       check, so the loop still terminates cleanly. ---- >>
    while (running) {
      << Dispatch one batch of host events. The return (dispatched count, or a
         negative error code) is intentionally not used as a quit signal; the
         window-close check below is the authoritative exit condition. >>
      uiAppPump(app, 1);
      << The user closed the window (X button): end the loop cleanly. >>
      if (uiWindowClosed(window) == 1) { running = false; }
      else {
        pollSliders();

        << Menubar top-level buttons toggle their dropdown panels. >>
        if (uiWidgetTakeActivated(mFileBtn()) == 1) { openMenu(0); }
        if (uiWidgetTakeActivated(mViewBtn()) == 1) { openMenu(1); }
        if (uiWidgetTakeActivated(mStreamBtn()) == 1) { openMenu(2); }
        if (uiWidgetTakeActivated(mHelpBtn()) == 1) { openMenu(3); }

        << File menu commands. Open Folder scans the folder named in the
           location bar and switches the gallery to its real images. >>
        if (uiWidgetTakeActivated(mFileOpen()) == 1) { openMenu(-1); openPicture(); }
        if (uiWidgetTakeActivated(mFileOpenFolder()) == 1) {
          String path = locationInput >= 0 ? uiWidgetGetText(locationInput) : "";
          if (path == null) path = "";
          loadFolder(path);
          openMenu(-1);
        }
        if (uiWidgetTakeActivated(mFileInfo()) == 1) {
          String where = folderLoaded ? ("folder " + folderPath) : "built-in demo set";
          setStatus("File - Media Information - " + pictureName(galleryIndex) + " (" + where + ", " + intToStr(galleryCount) + " item(s))");
          openMenu(-1);
        }
        if (uiWidgetTakeActivated(mFileQuit()) == 1) { openMenu(-1); running = false; uiAppQuit(app, 0); }

        << View menu commands. >>
        if (uiWidgetTakeActivated(mViewGallery()) == 1) { setStatus("View - Picture Gallery"); showPicture(); openMenu(-1); }
        if (uiWidgetTakeActivated(mViewPlayer()) == 1) { setStatus("View - Video Player"); openMenu(-1); }
        if (uiWidgetTakeActivated(mViewNext()) == 1) { nextPicture(); openMenu(-1); }
        if (uiWidgetTakeActivated(mViewPrev()) == 1) { prevPicture(); openMenu(-1); }
        if (uiWidgetTakeActivated(mViewFit()) == 1) { setStatus("View - Fit to Window: the gallery image scales to fit its card."); openMenu(-1); }

        << Stream (YouTube) menu commands. Load reads the location bar; Open
           hands the recognized video to the browser; Clear restores the local
           player. >>
        if (uiWidgetTakeActivated(mStreamLoad()) == 1) {
          String url = locationInput >= 0 ? uiWidgetGetText(locationInput) : "";
          if (url == null) url = "";
          loadStream(url);
          openMenu(-1);
        }
        if (uiWidgetTakeActivated(mStreamOpen()) == 1) { openStream(); openMenu(-1); }
        if (uiWidgetTakeActivated(mStreamClear()) == 1) { clearStream(); openMenu(-1); }

        << Help menu commands. >>
        if (uiWidgetTakeActivated(mHelpGuide()) == 1) { setStatus("Help - Media Guide: Prev/Next browse, Play/Pause/Stop and the sliders drive playback."); openMenu(-1); }
        if (uiWidgetTakeActivated(mHelpShortcuts()) == 1) { setStatus("Help - Shortcuts: File-Open picks a file; View pages the gallery; Stream loads a YouTube URL from the location bar."); openMenu(-1); }
        if (uiWidgetTakeActivated(mHelpAbout()) == 1) { setStatus("Help - MediaBrowser " + metaVersion + " by " + metaAuthor); openMenu(-1); }

        << Gallery navigation (header buttons and in-card buttons). >>
        if (uiWidgetTakeActivated(btnNext) == 1) { nextPicture(); }
        if (uiWidgetTakeActivated(btnPrev) == 1) { prevPicture(); }
        if (uiWidgetTakeActivated(gNext) == 1) { nextPicture(); }
        if (uiWidgetTakeActivated(gPrev) == 1) { prevPicture(); }

        << Video transport. >>
        if (uiWidgetTakeActivated(btnPlay) == 1) { playMedia(); }
        if (uiWidgetTakeActivated(btnPause) == 1) { pauseMedia(); }
        if (uiWidgetTakeActivated(btnStop) == 1) { stopMedia(); }

        << Stream handoff button in the player card. >>
        if (uiWidgetTakeActivated(btnStreamOpen) == 1) { openStream(); }
      }
    }

    uiAppDestroy(app); app = -1;
    if (theme >= 0) uiThemeDestroy(theme);
    theme = -1;
    print("event loop exited.");
  }
}
