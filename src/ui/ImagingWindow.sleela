#sleela 2.9
material;
class ImagingWindow {
 int app=-1; int theme=-1; int window=-1; int statusLabel=-1;
 int sourceInput=-1; int imageInput=-1; int movInput=-1; int mp4Input=-1; int mpegInput=-1; int aviInput=-1;
 int recursiveCheck=-1; int dryRunCheck=-1; int digestCheck=-1; int confirmCheck=-1;
 int previewButton=-1; int applyButton=-1; int quitButton=-1;
 boolean running=false;
 ImagingSession session;
 void setStatus(String message) { if (statusLabel>=0) uiWidgetSetText(statusLabel,message); }
 String safeText(int widget) { String value=uiWidgetGetText(widget); return value==null ? "" : value; }
 ImagingConfig readConfig() {
  ImagingConfig cfg=new ImagingConfig();
  cfg.sourceDirectory=safeText(sourceInput); cfg.imageDestination=safeText(imageInput);
  cfg.movDestination=safeText(movInput); cfg.mp4Destination=safeText(mp4Input);
  cfg.mpegDestination=safeText(mpegInput); cfg.aviDestination=safeText(aviInput);
  cfg.recursive=(uiWidgetGetToggle(recursiveCheck)==1);
  cfg.dryRun=(uiWidgetGetToggle(dryRunCheck)==1);
  cfg.verifyDigest=(uiWidgetGetToggle(digestCheck)==1);
  cfg.preserveSource=true; cfg.followSymbolicLinks=false;
  cfg.allowNetwork=false; cfg.deleteSource=false;
  return cfg;
 }
 void main() {
  app=uiAppCreate("com.mearvk.sleela.imaging");
  if (app<0) { print("SLeeLa Imaging: SleelaUI could not open a native display."); return; }
  theme=uiThemePreset(3);
  window=uiWindowCreate(app,"SLeeLa Imaging 2.9",1040,760,theme);
  if (window<0) { print("SLeeLa Imaging: native window creation failed."); uiAppDestroy(app); app=-1; return; }
  uiWindowSetBuffering(window,2); uiWindowSetMinSize(window,820,620);
  int root=uiWindowRoot(window); int page=uiBox(root,0,12);
  uiWidgetMargin(page,16,16,16,16); uiWidgetExpand(page,1,1);
  uiHeading(page,"SLeeLa Imaging",26);
  uiLabel(page,"Local-first photo and video organization. Originals are preserved.");
  int sourceFrame=uiFrame(page,"Source and destinations");
  int form=uiBox(sourceFrame,0,8); uiWidgetMargin(form,10,10,10,10);
  uiLabel(form,"Source directory"); sourceInput=uiEntry(form,"/path/to/source");
  uiLabel(form,"Images destination"); imageInput=uiEntry(form,"/path/to/organized/Images");
  int videoFrame=uiFrame(page,"Video destinations");
  int videos=uiBox(videoFrame,0,8); uiWidgetMargin(videos,10,10,10,10);
  uiLabel(videos,"MOV destination"); movInput=uiEntry(videos,"/path/to/organized/Videos/MOV");
  uiLabel(videos,"MP4 / M4V destination"); mp4Input=uiEntry(videos,"/path/to/organized/Videos/MP4");
  uiLabel(videos,"MPEG / MPG destination"); mpegInput=uiEntry(videos,"/path/to/organized/Videos/MPEG");
  uiLabel(videos,"AVI destination"); aviInput=uiEntry(videos,"/path/to/organized/Videos/AVI");
  int optionsFrame=uiFrame(page,"Review and safety");
  int options=uiBox(optionsFrame,0,6); uiWidgetMargin(options,10,10,10,10);
  recursiveCheck=uiCheckBox(options,"Scan subdirectories recursively",0);
  dryRunCheck=uiCheckBox(options,"Dry run — preview only (recommended)",1);
  digestCheck=uiCheckBox(options,"Require SHA-256 verification",1);
  confirmCheck=uiCheckBox(options,"I reviewed and explicitly confirm this exact plan",0);
  int actions=uiBox(page,1,10);
  previewButton=uiButton(actions,"Preview"); uiWidgetSuggested(previewButton,1);
  applyButton=uiButton(actions,"Apply verified plan"); uiWidgetSensitive(applyButton,0);
  uiWidgetDestructive(applyButton,0); quitButton=uiButton(actions,"Quit");
  statusLabel=uiInfoBar(page,"Ready. Filesystem provider is not yet bound; no files will be scanned.",1);
  uiWidgetSizeRequest(statusLabel,0,42);
  uiLabel(page,"Privacy: no network, telemetry, key upload, database logging, or source deletion.");
  session=new ImagingSession(); uiWindowShow(window); running=true;
  while (running) {
   int dispatched=uiAppPump(app,1);
   if (dispatched<0) { setStatus("UI event provider reported an error. No media operation was started."); running=false; }
   if (uiWidgetTakeActivated(previewButton)==1) {
    ImagingConfig cfg=readConfig(); session.configure(cfg); setStatus(session.preview());
    uiWidgetSensitive(applyButton,session.canApply(uiWidgetGetToggle(confirmCheck)==1) ? 1 : 0);
   }
   if (uiWidgetTakeActivated(confirmCheck)==1) {
    ImagingConfig current=readConfig();
    if (!session.sameConfiguration(current)) {
     session.configure(current); setStatus("Configuration changed. Preview again before confirming.");
     uiWidgetSensitive(applyButton,0);
    } else uiWidgetSensitive(applyButton,session.canApply(uiWidgetGetToggle(confirmCheck)==1) ? 1 : 0);
   }
   if (uiWidgetTakeActivated(applyButton)==1) {
    ImagingConfig current=readConfig();
    if (!session.sameConfiguration(current)) {
     session.configure(current); setStatus("Configuration changed. Preview again; apply was denied.");
    } else setStatus(session.requestApply(uiWidgetGetToggle(confirmCheck)==1));
    uiWidgetSensitive(applyButton,0);
   }
   if (uiWidgetTakeActivated(quitButton)==1) { running=false; uiAppQuit(app,0); }
  }
  uiAppDestroy(app); app=-1;
  if (theme>=0) uiThemeDestroy(theme);
  theme=-1;
 }
}