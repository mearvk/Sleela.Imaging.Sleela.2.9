<< Image and video extension classifier. >>
#sleela 2.9
material;
class MediaClassifier {
  boolean isImage(String e) {
    String x=e.toLowerCase();
    return x==".jpg" || x==".jpeg" || x==".heic" || x==".png" ||
      x==".tiff" || x==".tif" || x==".bmp" || x==".gif" || x==".webp";
  }
  boolean isVideo(String e) {
    String x=e.toLowerCase();
    return x==".mov" || x==".mp4" || x==".mpeg" || x==".mpg" ||
      x==".avi" || x==".m4v";
  }
  String category(String e) {
    if (isImage(e)) return "image";
    if (isVideo(e)) return "video";
    return "unsupported";
  }
}
