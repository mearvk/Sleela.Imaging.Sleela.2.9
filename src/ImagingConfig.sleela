<< Typed configuration for SLeeLa Imaging 2.9. >>
#sleela 2.9
material;
class ImagingConfig {
  String sourceDirectory = "";
  String imageDestination = "";
  String movDestination = "";
  String mp4Destination = "";
  String mpegDestination = "";
  String aviDestination = "";
  boolean recursive = false;
  boolean dryRun = true;
  boolean followSymbolicLinks = false;
  boolean verifyDigest = true;
  boolean preserveSource = true;
  boolean isConfigured() {
    return sourceDirectory != "" && imageDestination != "" &&
      movDestination != "" && mp4Destination != "" &&
      mpegDestination != "" && aviDestination != "";
  }
  String videoDestination(String ext) {
    if (ext == ".mov") return movDestination;
    if (ext == ".mp4" || ext == ".m4v") return mp4Destination;
    if (ext == ".mpeg" || ext == ".mpg") return mpegDestination;
    if (ext == ".avi") return aviDestination;
    return "";
  }
}
