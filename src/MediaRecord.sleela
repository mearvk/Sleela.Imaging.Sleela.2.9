<< Planned media operation record. >>
#sleela 2.9
material;
class MediaRecord {
  String sourcePath="";
  String originalName="";
  String extension="";
  String category="unsupported";
  String destinationDirectory="";
  String destinationName="";
  String dateSource="unknown";
  long captureTime=0;
  long byteCount=0;
  String digest="";
  String state="discovered";
  boolean isEligible() {
    return sourcePath!="" && destinationDirectory!="" &&
      destinationName!="" && captureTime>0 &&
      (category=="image" || category=="video");
  }
  boolean isReadyToPublish() { return state=="copied-and-verified"; }
}
