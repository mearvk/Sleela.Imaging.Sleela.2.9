<< Chronological names with a three-digit collision sequence. >>
#sleela 2.9
material;
class MediaNaming {
  String sequence(int n) {
    if (n < 1) return "000";
    if (n < 10) return "00" + n;
    if (n < 100) return "0" + n;
    return "" + n;
  }
  < timestamp is supplied by the platform as yyyy-MM-dd_HH-mm-ss. >
  String fileName(String timestamp, int n, String extension) {
    if (timestamp == "" || n < 1 || extension == "") return "";
    String ext=extension.toLowerCase();
    if (ext.charAt(0) != '.') ext="."+ext;
    return timestamp+"_"+sequence(n)+ext;
  }
}
