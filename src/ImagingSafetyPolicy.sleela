#sleela 2.9
material;
class ImagingSafetyPolicy {
 boolean validRoots(String source, String images, String mov, String mp4, String mpeg, String avi) {
  if (source=="" || images=="" || mov=="" || mp4=="" || mpeg=="" || avi=="") return false;
  if (source==images || source==mov || source==mp4 || source==mpeg || source==avi) return false;
  if (images==mov || images==mp4 || images==mpeg || images==avi) return false;
  if (mov==mp4 || mov==mpeg || mov==avi) return false;
  if (mp4==mpeg || mp4==avi || mpeg==avi) return false;
  return true;
 }
 boolean mayApply(boolean confirmed, boolean dryRun, boolean previewComplete, boolean sourcePreserved, boolean bridgeBound, boolean atomicNoReplace, boolean digestSupported, boolean stableSnapshot) {
  return confirmed && !dryRun && previewComplete && sourcePreserved && bridgeBound && atomicNoReplace && digestSupported && stableSnapshot;
 }
 boolean mayPublish(boolean temporaryCopyExists, boolean destinationVerified, boolean sourcePreserved, boolean atomicNoReplace) {
  return temporaryCopyExists && destinationVerified && sourcePreserved && atomicNoReplace;
 }
 boolean mayDeleteSource(boolean requested) { return false; }
 boolean mayUseNetwork() { return false; }
 boolean mayUploadMedia() { return false; }
 boolean mayTransmitMediaMetadata() { return false; }
 boolean mayFollowSymbolicLink(boolean requested) { return false; }
}