<< ImagingApplication — top-level wiring for the SLeeLa-native edition.

   Owns a single ImagingSession and exposes the headless organize workflow
   (configure -> preview -> apply). The session drives the real native
   ImagingFileSystem provider directly through the VM OS built-ins; there is no
   out-of-process bridge in the original edition. >>
#sleela 2.9
material;
class ImagingApplication {
  ImagingConfig config;
  ImagingSession session;
  ImagingSafetyPolicy safety;

  void configure(ImagingConfig value) {
    config = value;
    safety = new ImagingSafetyPolicy();
    session = new ImagingSession();
    session.configure(value);
  }

  boolean ready() {
    if (config == null || !config.isConfigured()) return false;
    return safety.validRoots(config.sourceDirectory, config.imageDestination,
      config.movDestination, config.mp4Destination, config.mpegDestination, config.aviDestination);
  }

  < Run a read-only preview and return its status line. >
  String preview() {
    if (session == null) return "configuration-missing";
    return session.preview();
  }

  < Apply the reviewed plan (requires explicit confirmation and a safe config). >
  String apply(boolean confirmed) {
    if (session == null) return "configuration-missing";
    return session.requestApply(confirmed);
  }

  int planned() { return session == null ? 0 : session.planned(); }
  int published() { return session == null ? 0 : session.published(); }
  int failed() { return session == null ? 0 : session.failed(); }
  int skipped() { return session == null ? 0 : session.skipped(); }

  String status() {
    if (config == null || !config.isConfigured()) return "configuration-invalid-or-incomplete";
    if (!ready()) return "canonical-root-proof-required";
    return session.status();
  }
}
